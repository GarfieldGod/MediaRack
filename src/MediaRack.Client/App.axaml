<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaRack.Client.ViewModels"
             xmlns:views="clr-namespace:MediaRack.Client.Views"
             x:Class="MediaRack.Client.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <!-- 页面 = ViewModel，按类型自动选视图，切页不用写导航代码 -->
    <Application.DataTemplates>
        <DataTemplate DataType="vm:ConnectViewModel">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:MineViewModel">
            <views:MineView />
        </DataTemplate>
        <DataTemplate DataType="vm:PlayerViewModel">
            <views:PlayerView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
