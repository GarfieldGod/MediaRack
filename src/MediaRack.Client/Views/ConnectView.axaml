<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaRack.Client.ViewModels"
             x:Class="MediaRack.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,3" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="28">
        <StackPanel Spacing="8" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="连接一个源" FontSize="22" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="一条配置就是一个源。把管理页「访问方式」里那一整行（带「复制」按钮的那个）粘进来就行，地址和源标识会自己拆开；配对二维码的内容粘进来也一样，里面有好几个候选地址时会自动挑一个能连上的。" />

            <!-- ═══ 一个框 ═══ -->
            <TextBlock Text="源地址" Classes="field" />
            <TextBox Text="{Binding SourceUrl, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="http://192.0.2.10:8080/SB"
                     FontFamily="Consolas, Menlo, monospace" />

            <!-- 解析回显：单框必须配这个，否则"端口写错"和"源标识写错"在界面上长得一模一样 -->
            <TextBlock Text="{Binding AddressPreview}" Classes="hint"
                       IsVisible="{Binding !IsAddressProblem}" />
            <TextBlock Text="{Binding AddressPreview}" Classes="hint" Foreground="#E5484D" Opacity="1"
                       IsVisible="{Binding IsAddressProblem}" />

            <TextBlock Text="访问令牌" Classes="field" />
            <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="管理页里查看；粘带 #token= 的链接会自己填进来；公开源留空" />

            <TextBlock Text="名称（选填）" Classes="field" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="留空就用服务端里这个源的名字" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
                <Button Content="连接" Command="{Binding ConnectCommand}"
                        HorizontalAlignment="Left" Padding="20,8" Classes="accent" />
                <TextBlock Text="{Binding EditHint}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                           IsVisible="{Binding IsEditing}" />
                <Button Content="取消编辑" Command="{Binding CancelEditCommand}" Classes="mini"
                        VerticalAlignment="Center" IsVisible="{Binding IsEditing}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8"
                       IsVisible="{Binding !IsError}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#E5484D"
                       IsVisible="{Binding IsError}" />

            <!-- ═══ 已保存的源 ═══ -->
            <TextBlock Text="已保存的源" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="可以同时连着多个源；这里点「连接」只是再开一个，不影响已经连着的。"
                       Classes="hint" Margin="0,0,0,2" />

            <ItemsControl ItemsSource="{Binding Saved}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SavedSource">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.55" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ConnectLabel}" Margin="8,0,0,0"
                                        Command="{Binding ConnectCommand}" />
                                <Button Grid.Column="2" Content="编辑" Command="{Binding EditCommand}" />
                                <Button Grid.Column="3" Content="删除" Command="{Binding DeleteCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
