<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaRack.Client.ViewModels"
             x:Class="MediaRack.Client.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <!-- 卡片是"整块可点"，不要按钮那种边框和底色 -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.card:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.card:pointerover TextBlock.cardtitle">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorLight2}" />
        </Style>

        <!-- 合集卡：整块可点，底色比海报区浅一档，鼠标悬停才亮 -->
        <Style Selector="Button.colcard">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style Selector="Button.colcard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>

        <!-- 收藏夹 chip：✓ 是"在夹子里"，＋ 是"加进去" -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="#332E9EFF" />
            <Setter Property="BorderBrush" Value="#662E9EFF" />
        </Style>

        <!-- 海报墙外层是 ListBox（为了虚拟化），把行的选中底色去掉 -->
        <Style Selector="ListBox#GridList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#GridList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#GridList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 合集网格同样是 ListBox（虚拟化），去掉选中/悬停底色 -->
        <Style Selector="ListBox#CollectionList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#CollectionList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#CollectionList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- 侧栏导航：标题小、项紧凑 -->
        <Style Selector="TextBlock.navhead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Margin" Value="12,14,0,4" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.mini">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 源（会话）：整行可点，当前那条用底色区分。等价 APK 抽屉里那份源列表 -->
        <Style Selector="Button.session">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.session.current /template/ ContentPresenter">
            <Setter Property="Background" Value="#262E9EFF" />
        </Style>
        <Style Selector="Button.session:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>

        <!-- 源行右侧的小工具（改 / 断开）：平时半透明，鼠标移到这一行才全亮 -->
        <Style Selector="Button.navtool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navtool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}" />
        </Style>
        <Style Selector="Button.navtool:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <!-- ═══ 浏览层 ═══ -->
        <Grid ColumnDefinitions="250,*">

        <!-- ═══ 左：导航 ═══ -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,0,1,0">
            <ScrollViewer>
                <StackPanel Spacing="0" Margin="0,4,0,16">

                    <!-- 源：这台机器上连着的每一个源（可同时连多个），点一行换一页。
                         与 APK 抽屉里的源列表同一个东西，只是横过来放在左栏。 -->
                    <StackPanel IsVisible="{Binding HasSessions}" Spacing="0">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,10,0">
                            <TextBlock Grid.Column="0" Text="源" Classes="navhead" />
                            <Button Grid.Column="1" Content="＋ 添加" Classes="mini"
                                    Padding="8,1" Margin="0,11,6,0" FontSize="11"
                                    ToolTip.Tip="连接另一个源（不影响已经连着的）"
                                    Command="{Binding AddSourceCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:SourceSession">
                                    <!-- 整行可点切源，右侧两个小按钮（改 / 断开）——与 APK 抽屉里
                                         长按源弹出的「编辑 / 删除」同一组动作，只是摊开成图标 -->
                                    <Grid ColumnDefinitions="*,Auto" Margin="6,0,6,2">
                                        <Button Grid.Column="0" Classes="session"
                                                Classes.current="{Binding IsCurrent}"
                                                Command="{Binding ActivateCommand}"
                                                ToolTip.Tip="{Binding Subtitle}">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="2,0,0,0">
                                            <Button Classes="navtool" Content="改"
                                                    Command="{Binding EditCommand}"
                                                    ToolTip.Tip="编辑这个源（地址 / 令牌 / 名称）" />
                                            <Button Classes="navtool" Content="✕"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip.Tip="断开并从列表移除（配置保留，连接页能重连）" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="浏览" Classes="navhead" />
                    <ListBox x:Name="SourceList"
                             ItemsSource="{Binding SourceNavs}"
                             SelectedItem="{Binding SelectedSourceNav}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavItem">
                                <StackPanel Spacing="1" Margin="2,1">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 收藏夹：标题行右侧的 ＋ 与内联新建 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,10,0">
                        <TextBlock Grid.Column="0" Text="收藏夹" Classes="navhead" />
                        <Button Grid.Column="1" Content="＋ 新建" Classes="mini"
                                Padding="8,1" Margin="0,11,6,0" FontSize="11"
                                ToolTip.Tip="新建收藏夹"
                                Command="{Binding BeginCreateFavoriteCommand}" />
                    </Grid>

                    <StackPanel Spacing="6" Margin="12,2,12,6"
                                IsVisible="{Binding IsCreatingFavorite}">
                        <TextBox Text="{Binding NewFavoriteName}" FontSize="12"
                                 PlaceholderText="收藏夹名字" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="创建" Classes="mini" Command="{Binding CommitCreateFavoriteCommand}" />
                            <Button Content="取消" Classes="mini" Command="{Binding CancelCreateFavoriteCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="FavoriteList"
                             ItemsSource="{Binding FavoriteNavs}"
                             SelectedItem="{Binding SelectedFavoriteNav}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavItem">
                                <StackPanel Spacing="1" Margin="2,1">
                                    <TextBlock Text="{Binding Title}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.55"
                                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Opacity="0.4" FontSize="11" Margin="14,18,12,0" TextWrapping="Wrap"
                               Text="「合集」是源里的目录 / UP 主，只读；收藏夹属于你，这里只列当前源里收藏的东西。" />

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ═══ 右：标题 + 工具栏 + 内容 ═══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

            <!-- 标题行：当前位置 + 收藏夹工具 + 计数 + 刷新 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                  ColumnSpacing="8" Margin="16,10,16,2">

                <Button Grid.Column="0" Content="← 合集" Classes="mini"
                        IsVisible="{Binding ShowCollectionBack}"
                        ToolTip.Tip="回到合集列表"
                        Command="{Binding CollectionBackCommand}" />

                <TextBlock Grid.Column="1" Text="{Binding HeadingText}" Classes="heading" />

                <!-- 收藏夹工具：默认显示两个按钮，重命名 / 确认删除时占同一格 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding ShowFavoriteTools}">
                    <Button Content="重命名" Classes="mini" Command="{Binding BeginRenameFavoriteCommand}" />
                    <Button Content="删除" Classes="mini" Command="{Binding BeginDeleteFavoriteCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding IsRenamingFavorite}">
                    <TextBox Text="{Binding RenameText}" FontSize="12" Width="180"
                             PlaceholderText="新名字" VerticalAlignment="Center" />
                    <Button Content="保存" Classes="mini" Command="{Binding CommitRenameFavoriteCommand}" />
                    <Button Content="取消" Classes="mini" Command="{Binding CancelRenameFavoriteCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                            IsVisible="{Binding ConfirmDeleteFavorite}">
                    <TextBlock Text="删除这个收藏夹？条目本身不会被删。" FontSize="12" Opacity="0.75"
                               VerticalAlignment="Center" />
                    <Button Content="确认删除" Classes="mini" Command="{Binding CommitDeleteFavoriteCommand}" />
                    <Button Content="取消" Classes="mini" Command="{Binding CancelDeleteFavoriteCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="4" Text="{Binding CountText}" Opacity="0.6" FontSize="12"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !ShowCollectionGrid}" />

                <Button Grid.Column="5" Content="刷新" Classes="mini"
                        Command="{Binding RefreshCommand}"
                        IsVisible="{Binding !ShowCollectionGrid}" />
                <Button Grid.Column="5" Content="刷新" Classes="mini"
                        Command="{Binding ReloadCollectionsCommand}"
                        IsVisible="{Binding ShowCollectionGrid}" />
            </Grid>

            <!-- 海报墙工具栏 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"
                  Margin="16,6,16,10" IsVisible="{Binding !ShowCollectionGrid}">
                <TextBox Grid.Column="0"
                         Text="{Binding Query}"
                         PlaceholderText="搜索标题 / UP 主（输入即搜）"
                         VerticalAlignment="Center" />

                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Collections}"
                          SelectedItem="{Binding SelectedCollection}"
                          MinWidth="170" VerticalAlignment="Center"
                          IsVisible="{Binding ShowCollectionFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:CollectionOption">
                            <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <CheckBox Grid.Column="2" Content="最近加入" IsChecked="{Binding SortAdded}"
                          IsVisible="{Binding ShowSort}" VerticalAlignment="Center" />
            </Grid>

            <!-- 合集网格工具栏 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10"
                  Margin="16,6,16,10" IsVisible="{Binding ShowCollectionGrid}">
                <TextBox Grid.Column="0" Text="{Binding CollectionQuery}"
                         PlaceholderText="过滤合集（名字 / 源 / 路径）" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CollectionCountText}" Opacity="0.6"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>

            <!-- 错误条 -->
            <Border Grid.Row="2" Padding="16,8" Background="#33E5484D"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding Error}" Foreground="#E5484D" TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">

                <!-- ① 海报墙 -->
                <Grid Grid.Column="0" IsVisible="{Binding !ShowCollectionGrid}">
                    <ListBox x:Name="GridList"
                             ItemsSource="{Binding Rows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="20,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:MediaRow">
                                <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="14" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:MediaCard">
                                            <Button Classes="card" Width="188"
                                                    Command="{Binding OpenCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Title}">
                                                <StackPanel Spacing="6">

                                                    <Border Height="238" CornerRadius="8" ClipToBounds="True"
                                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                                        <Grid>
                                                            <Image Source="{Binding Poster}"
                                                                   Stretch="UniformToFill"
                                                                   Loaded="OnPosterLoaded" />

                                                            <!-- 没封面时的占位（服务端还没抽帧 / 源里没有封面） -->
                                                            <TextBlock Text="▶" FontSize="26" Opacity="0.25"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       IsVisible="{Binding !HasPoster}" />

                                                            <!-- 续播进度条压在海报底边 -->
                                                            <ProgressBar Value="{Binding ProgressPercent}"
                                                                         Minimum="0" Maximum="100"
                                                                         Height="3" CornerRadius="0"
                                                                         VerticalAlignment="Bottom"
                                                                         IsVisible="{Binding HasProgress}" />

                                                            <Border IsVisible="{Binding IsBroken}"
                                                                    Background="#CCE5484D"
                                                                    CornerRadius="4" Padding="6,2"
                                                                    Margin="6" HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding BrokenText}" FontSize="10"
                                                                           Foreground="White" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Text="{Binding Title}"
                                                               Classes="cardtitle"
                                                               FontSize="13" MaxLines="2"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Text="{Binding MetaLine}"
                                                               FontSize="11" Opacity="0.55"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <TextBlock Text="{Binding SubLine}"
                                                               FontSize="11" Opacity="0.4"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding !HasProgress}" />

                                                    <!-- 有进度就用这行替代副行（同一行高，整行卡片不会参差不齐） -->
                                                    <TextBlock Text="{Binding ProgressText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SystemAccentColorLight2}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding HasProgress}" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 空状态 -->
                    <TextBlock Text="{Binding EmptyText}"
                               IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" />

                    <!-- 底部：加载更多（滚到底也会自动加载，这个按钮是兜底） -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,16"
                            IsVisible="{Binding CanLoadMore}"
                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                            CornerRadius="16" Padding="14,6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                            <Button Content="加载更多" Command="{Binding LoadMoreCommand}"
                                    FontSize="12" Padding="10,3" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ② 合集网格 -->
                <Grid Grid.Column="0" IsVisible="{Binding ShowCollectionGrid}">
                    <ListBox x:Name="CollectionList"
                             ItemsSource="{Binding CollectionRows}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="20,8">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:CollectionRow">
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:CollectionCard">
                                            <Button Classes="colcard"
                                                    Command="{Binding OpenCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="{Binding Path}">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                                               MaxLines="2" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.55"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding CollectionEmptyText}"
                               IsVisible="{Binding CollectionEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5" />
                </Grid>

                <!-- ③ 详情侧栏 -->
                <Border Grid.Column="1" Width="300"
                        IsVisible="{Binding HasSelection}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer>
                        <StackPanel Spacing="10" Margin="16">

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="详情" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" FontSize="12" Padding="8,3"
                                        Command="{Binding CloseDetailCommand}"
                                        CommandParameter="{Binding SelectedCard}" />
                            </Grid>

                            <Border Height="170" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
                                <Image Source="{Binding SelectedCard.Poster}" Stretch="UniformToFill" />
                            </Border>

                            <TextBlock Text="{Binding SelectedCard.Title}" TextWrapping="Wrap"
                                       FontSize="14" FontWeight="SemiBold" />

                            <TextBlock Text="{Binding SelectedCard.UpName}" Opacity="0.7" FontSize="12"
                                       IsVisible="{Binding SelectedCard.UpName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{Binding SelectedCard.MetaLine}" Opacity="0.7" FontSize="12" />

                            <TextBlock Text="{Binding SelectedCard.ProgressText}" FontSize="12"
                                       Foreground="{DynamicResource SystemAccentColorLight2}"
                                       IsVisible="{Binding SelectedCard.HasProgress}" />

                            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" Margin="0,6,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="源" Opacity="0.55" FontSize="12" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCard.SourceId}" FontSize="12" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="合集" Opacity="0.55" FontSize="12" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCard.CollectionName}"
                                           FontSize="12" TextWrapping="Wrap" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Key" Opacity="0.55" FontSize="12" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCard.Key}"
                                           FontSize="11" TextWrapping="Wrap" Opacity="0.75" />
                            </Grid>

                            <Button Content="播放" Classes="accent" HorizontalAlignment="Stretch"
                                    Command="{Binding PlayCommand}"
                                    CommandParameter="{Binding SelectedCard}"
                                    Margin="0,10,0,0" />

                            <!-- 收藏到：一次点击 = 一次 /favorites/{id}/items，成功才翻状态 -->
                            <TextBlock Text="收藏到" FontSize="11" Opacity="0.55" Margin="0,10,0,0" />

                            <ItemsControl ItemsSource="{Binding FavoriteChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FavoriteChip">
                                        <Button Classes="chip"
                                                Classes.on="{Binding On}"
                                                Command="{Binding ToggleCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{Binding Tip}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Text="{Binding Mark}" FontSize="11" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding FavoriteEmptyText}" FontSize="11" Opacity="0.45"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding FavoriteEmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <TextBlock Text="{Binding FavoriteHint}" FontSize="11"
                                       Foreground="{DynamicResource SystemAccentColorLight2}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding HasFavoriteHint}" />

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Grid>
    </Grid>

        <!-- ═══ 播放层 ═══
             盖在海报墙上面而不是换页：返回时列表还在视觉树里，滚动位置原样保留
             （换页会重建 HomeView，用户滚了半小时的位置全丢）。
        -->
        <ContentControl Content="{Binding Player}" IsVisible="{Binding HasPlayer}" />

    </Grid>
</UserControl>
