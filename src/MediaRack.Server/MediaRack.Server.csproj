<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!--
      产物名与发布目录对齐：MediaRack-Server.exe 落在 MediaRack-Server-Windows-x64/。
      原来是全小写 mediarack-server，跟同一批产物的 MediaRack-* 排在一起像两个项目的东西。
    -->
    <AssemblyName>MediaRack-Server</AssemblyName>
    <RootNamespace>MediaRack.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MediaRack.Core\MediaRack.Core.csproj" />
  </ItemGroup>

  <!-- 配对二维码（主路径见 docs/design.md §10）：服务端出 SVG，浏览器 img 直用，不引前端 JS 库 -->
  <ItemGroup>
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <!--
    Web 管理页编进程序集，而不是留在 wwwroot 等拷贝。
    这样「一个 exe 拿走就能跑」，也不会出现「忘了拷 wwwroot 导致首页 404」。
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>

  <!--
    [没有 appsettings.json，这是故意的]

    交付物必须**只有一个 exe**（publish/MediaRack-Server-Windows-x64/MediaRack-Server.exe），
    而 appsettings.json 作为 Content 会原样落在 exe 旁边，一个 exe 就拿不走了。

    它原先装的东西各有归宿：
      · Logging 的两条过滤 -> MediaRackHost.Compose 里一句 AddFilter（本来就只影响日志噪音）
      · MediaRack 节的四个键 -> ServerOptions 的代码默认值，逐项对齐过
        （MetaRoot 空 = %LOCALAPPDATA%\MediaRack，ExportBudgetBytes = 20 GiB，
          PosterWidth = 560，Token 空 = 不鉴权）
      · AllowedHosts: "*" -> 不是配置就等于不过滤，等价

    要临时改级别/预算，走环境变量（Logging__LogLevel__Default、MediaRack__ExportBudgetBytes），
    或者放一个 mediarack.config.json 做便携覆盖——那两种都不是"随手能改坏的默认值"。
  -->

</Project>
