# ============================================================
# MediaRack —— 只跟踪「删掉就再也造不出来」的东西
# 判据：删掉之后能不能用一条命令重建？
#   能（编译产物、发布包、apk）    -> 忽略
#   不能（源码、契约、文档、脚本） -> 提交
# ============================================================

# ── .NET 构建产物 ─────────────────────────────────────────
bin/
obj/
*.user
*.suo
*.userprefs
*.pdb
*.binlog
project.lock.json
*.DotSettings.user

# ── 发布产物（build.sh 生成，可随时重出）──────────────────
publish/
dist/
artifacts/

# ── Android / Gradle ─────────────────────────────────────
.gradle/
build/
captures/
.cxx/
local.properties
*.apk
*.aab
*.jks
*.keystore

# ── IDE / 编辑器 ─────────────────────────────────────────
.vs/
.idea/
.vscode/
*.swp
*~

# ── 本地工具链（契约校验用的 python venv）────────────────
.tools/

# ── 运行时数据（库目录、日志、导出，绝不入库）────────────
*.db
*.db-wal
*.db-shm
meta/
export/
logs/

# ── 历史归档（旧截图、旧设计稿，不入库）──────────────────
.archive/

# ── AI 工作区记忆（含本机路径与内网地址，绝不入库）────────
.workbuddy/

# ── 系统与临时文件 ───────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.log
~$*
