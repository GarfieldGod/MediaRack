<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MediaRack.Client.ViewModels"
             x:Class="MediaRack.Client.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">

    <UserControl.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer Padding="28">
        <StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="连接一个源" FontSize="22" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="一条配置就是一个源。四个字段与服务端管理页「访问方式」里的那张表一一对应；拿到配对二维码的话，把码里的内容粘到下方一次填满。" />

            <!-- ═══ 四栏 ═══ -->
            <Grid ColumnDefinitions="*,110" ColumnSpacing="10" Margin="0,6,0,0">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="服务器地址" Classes="field" />
                    <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="192.0.2.10 或主机名" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="端口" Classes="field" />
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="8080" />
                </StackPanel>
            </Grid>

            <StackPanel>
                <TextBlock Text="源地址（必填）" Classes="field" />
                <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="movie" />
                <TextBlock Text="管理页里这个源的「源标识」，地址会拼成 /s/{源标识}。一条配置只连一个源，所以这一栏不能空；没有它就只能连服务端根，而根是管理页专用通道。" Classes="hint" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="访问令牌" Classes="field" />
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="管理页里查看，或粘配对码自动回填；公开源留空" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="名称（选填）" Classes="field" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="留空就用服务端里这个源的名字" />
            </StackPanel>

            <!-- ═══ 粘贴配对码（桌面没有摄像头，扫码换成粘贴）═══ -->
            <StackPanel>
                <TextBlock Text="配对码 / 带令牌的链接（选填）" Classes="field" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Text="{Binding Paste, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="False"
                             PlaceholderText="MR1|{&quot;token&quot;:…}  或  http://192.0.2.10:8080/s/movie#token=…" />
                    <Button Grid.Column="1" Content="回填" Command="{Binding PasteCommand}"
                            Padding="14,6" VerticalAlignment="Stretch" />
                </Grid>
            </StackPanel>

            <!-- 拼出来的完整地址：点连接前先看清连的是哪儿 -->
            <TextBlock Text="{Binding AddressPreview}" Classes="hint" Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                <Button Content="连接" Command="{Binding ConnectCommand}"
                        HorizontalAlignment="Left" Padding="20,8" Classes="accent" />
                <TextBlock Text="{Binding EditHint}" VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                           IsVisible="{Binding IsEditing}" />
                <Button Content="取消编辑" Command="{Binding CancelEditCommand}" Classes="mini"
                        VerticalAlignment="Center" IsVisible="{Binding IsEditing}" />
            </StackPanel>

            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8"
                       IsVisible="{Binding !IsError}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#E5484D"
                       IsVisible="{Binding IsError}" />

            <!-- ═══ 已保存的源 ═══ -->
            <TextBlock Text="已保存的源" FontWeight="SemiBold" Margin="0,16,0,0" />
            <TextBlock Text="可以同时连着多个源；这里点「连接」只是再开一个，不影响已经连着的。"
                       Classes="hint" Margin="0,0,0,2" />

            <ItemsControl ItemsSource="{Binding Saved}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SavedSource">
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.55" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ConnectLabel}" Margin="8,0,0,0"
                                        Command="{Binding ConnectCommand}" />
                                <Button Grid.Column="2" Content="编辑" Command="{Binding EditCommand}" />
                                <Button Grid.Column="3" Content="删除" Command="{Binding DeleteCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
